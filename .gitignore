# Игнорируем временный системный мусор внутри корня ChiNux
__root__/tmp/*
__root__/run/*
__root__/proc/*
__root__/sys/*
__root__/dev/*
__root__/usr/lib/x86_64-linux-gnu/
__root__/var/lib/apt/lists/
__root__/var/cache/
# Игнорируем логи и виртуальное окружение Python
__root__/var/log/*
.venv/
__pycache__/
*.pyc
